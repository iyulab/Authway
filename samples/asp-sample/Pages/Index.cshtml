@page
@using AuthwaySample
@{
    ViewData["Title"] = Texts.Get("home.title");
}

<h1>@Texts.Get("home.heading")</h1>

@if (User.Identity?.IsAuthenticated == true)
{
    <p>@Texts.Get("home.signedInAs") <strong>@User.Identity.Name</strong>. <a href="/Account">@Texts.Get("home.yourAccount")</a></p>
}
else
{
    <p>@Texts.Get("home.explain")</p>
    <p><a class="button" href="/login?returnUrl=/Account">@Texts.Get("signIn")</a></p>
}
