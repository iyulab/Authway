@page
@model AccountModel
@using AuthwaySample
@{
    ViewData["Title"] = Texts.Get("account.title");
}

<h1>@Texts.Get("account.heading")</h1>

<p>@Texts.Get("account.intro")</p>

<dl>
    <dt>@Texts.Get("account.userId")</dt>
    <dd>@Model.UserId</dd>
    <dt>@Texts.Get("account.name")</dt>
    <dd>@User.Identity?.Name</dd>
    <dt>@Texts.Get("account.role")</dt>
    <dd>@Model.Role</dd>
</dl>

<form method="post" asp-page-handler="Logout">
    <button type="submit">@Texts.Get("signOut")</button>
</form>
