@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="container">
    <h1 class="mb-4">👤 User Profile</h1>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Authentication Information</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Username:</dt>
                <dd class="col-sm-9">@Model.UserName</dd>

                <dt class="col-sm-3">Authenticated:</dt>
                <dd class="col-sm-9">
                    @if (Model.IsAuthenticated)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No</span>
                    }
                </dd>

                <dt class="col-sm-3">Authentication Type:</dt>
                <dd class="col-sm-9">@Model.AuthenticationType</dd>
            </dl>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">User Claims <small class="text-muted">(merged from ID Token & DB)</small></h5>
            <button id="refreshClaimsBtn" class="btn btn-sm btn-outline-primary">
                <span id="refreshClaimsText">🔄 Refresh from DB</span>
                <span id="refreshClaimsSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
            </button>
        </div>
        <div class="card-body">
            <div id="userClaimsContainer">
                @if (Model.Claims.Any())
                {
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Claim Type</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody id="claimsTableBody">
                            @foreach (var claim in Model.Claims)
                            {
                                <tr>
                                    <td><code>@claim.Key</code></td>
                                    <td>@claim.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No claims available.</p>
                }
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0">Access Tokens</h5>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.AccessToken))
            {
                <div class="mb-3">
                    <label class="form-label"><strong>Access Token:</strong></label>
                    <textarea class="form-control font-monospace" rows="3" readonly>@Model.AccessToken</textarea>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.IdToken))
            {
                <div class="mb-3">
                    <label class="form-label"><strong>ID Token:</strong></label>
                    <textarea class="form-control font-monospace" rows="3" readonly>@Model.IdToken</textarea>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.RefreshToken))
            {
                <div class="mb-3">
                    <label class="form-label"><strong>Refresh Token:</strong></label>
                    <textarea class="form-control font-monospace" rows="2" readonly>@Model.RefreshToken</textarea>
                </div>
            }

            @if (string.IsNullOrEmpty(Model.AccessToken) && string.IsNullOrEmpty(Model.IdToken))
            {
                <p class="text-muted">No tokens available.</p>
            }
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0">🔧 Dynamic Claims</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info mb-3">
                <strong>📝 How it works:</strong>
                <ul class="mb-0 mt-2">
                    <li>Claims are saved to the database immediately</li>
                    <li>Use "🔄 Refresh from DB" button above to see updated claims with <span class="badge bg-success">DB</span> badge</li>
                    <li>New claims will be included in your ID token after your next login</li>
                </ul>
            </div>

            <!-- Tabs for different claim management options -->
            <ul class="nav nav-tabs mb-3" id="claimsTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="custom-tab" data-bs-toggle="tab" data-bs-target="#custom" type="button" role="tab">
                        Custom Claims
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="workspace-tab" data-bs-toggle="tab" data-bs-target="#workspace" type="button" role="tab">
                        Workspace Switch
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="claimsTabContent">
                <!-- Custom Claims Tab -->
                <div class="tab-pane fade show active" id="custom" role="tabpanel">
                    <form id="customClaimsForm">
                        <div id="claimPairs">
                            <!-- Dynamic claim pairs will be added here -->
                        </div>

                        <button type="button" class="btn btn-sm btn-outline-primary mb-3" id="addClaimBtn">
                            + Add Claim
                        </button>

                        <hr>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="permanentClaims" name="permanent">
                                <label class="form-check-label" for="permanentClaims">
                                    Make claims permanent (persist across sessions)
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success" id="updateClaimsBtn">
                            <span id="updateClaimsBtnText">Update Claims</span>
                            <span id="updateClaimsBtnSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                        </button>

                        <button type="button" class="btn btn-primary ms-2" id="refreshTokenBtn">
                            <span id="refreshTokenBtnText">🔄 Refresh Token</span>
                            <span id="refreshTokenBtnSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                        </button>

                        <div id="customClaimsStatus" class="mt-3"></div>
                    </form>
                </div>

                <!-- Workspace Switch Tab -->
                <div class="tab-pane fade" id="workspace" role="tabpanel">
                    <form id="workspaceSwitchForm">
                        <div class="mb-3">
                            <label for="workspaceSelect" class="form-label"><strong>Select Workspace:</strong></label>
                            <select class="form-select" id="workspaceSelect" name="workspaceId">
                                <option value="">-- Select a workspace --</option>
                                <option value="ws-dev">Development Workspace</option>
                                <option value="ws-staging">Staging Workspace</option>
                                <option value="ws-prod">Production Workspace</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-success" id="switchBtn">
                            <span id="switchBtnText">Switch Workspace</span>
                            <span id="switchBtnSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                        </button>

                        <div id="switchStatus" class="mt-3"></div>
                    </form>

                    <div class="mt-4">
                        <h6>Current Workspace Claims:</h6>
                        <div id="currentWorkspace" class="alert alert-info">
                            @{
                                var workspaceId = Model.Claims.ContainsKey("workspace_id") ? Model.Claims["workspace_id"] : "None";
                                var workspaceName = Model.Claims.ContainsKey("workspace_name") ? Model.Claims["workspace_name"] : "Not set";
                            }
                            <strong>ID:</strong> @workspaceId<br>
                            <strong>Name:</strong> @workspaceName
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to Home</a>
        <a class="btn btn-outline-danger ms-2" asp-controller="Home" asp-action="Logout">Logout</a>
    </div>
</div>

<script>
    // Pass server-side claims to JavaScript
    const idTokenClaims = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Claims));

    // Refresh User Claims from DB
    async function refreshUserClaimsFromDB() {
        const btn = document.getElementById('refreshClaimsBtn');
        const spinner = document.getElementById('refreshClaimsSpinner');
        const text = document.getElementById('refreshClaimsText');
        const container = document.getElementById('userClaimsContainer');

        try {
            btn.disabled = true;
            spinner.classList.remove('d-none');
            text.textContent = 'Loading...';

            // Call server-side proxy endpoint to avoid CORS issues
            const response = await fetch('/Home/GetUserClaims', {
                method: 'GET'
            });

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }

            const data = await response.json();

            // Rebuild claims table with DB claims taking priority
            let tableHtml = '<table class="table table-striped"><thead><tr><th>Claim Type</th><th>Value</th></tr></thead><tbody>';

            // Track which claims we've added from DB
            const addedFromDB = new Set();

            // Add user claims from DB first (with badge) - these are the most current values
            if (data.claims && Object.keys(data.claims).length > 0) {
                for (const [key, value] of Object.entries(data.claims)) {
                    tableHtml += `<tr><td><code>${key}</code> <span class="badge bg-success">DB</span></td><td>${value}</td></tr>`;
                    addedFromDB.add(key);
                }
            }

            // Add remaining claims from ID token that aren't in DB
            for (const [key, value] of Object.entries(idTokenClaims)) {
                if (value && !addedFromDB.has(key)) {
                    tableHtml += `<tr><td><code>${key}</code></td><td>${value}</td></tr>`;
                }
            }

            tableHtml += '</tbody></table>';
            container.innerHTML = tableHtml;

            // Show success feedback
            text.textContent = '✓ Refreshed';
            setTimeout(() => {
                text.textContent = '🔄 Refresh from DB';
            }, 2000);

        } catch (error) {
            console.error('Failed to refresh claims:', error);
            container.innerHTML = '<div class="alert alert-danger">Failed to load claims from DB. Please try again.</div>';
            text.textContent = '✗ Failed';
            setTimeout(() => {
                text.textContent = '🔄 Refresh from DB';
            }, 2000);
        } finally {
            btn.disabled = false;
            spinner.classList.add('d-none');
        }
    }

    // Refresh button click handler
    document.getElementById('refreshClaimsBtn')?.addEventListener('click', refreshUserClaimsFromDB);

    // Custom Claims Management
    let claimCounter = 0;

    function addClaimPair(key = '', value = '') {
        const pairId = claimCounter++;
        const pairHtml = `
            <div class="row mb-2" id="claimPair${pairId}">
                <div class="col-5">
                    <input type="text" class="form-control" placeholder="Claim key" name="claimKey[]" value="${key}">
                </div>
                <div class="col-5">
                    <input type="text" class="form-control" placeholder="Claim value" name="claimValue[]" value="${value}">
                </div>
                <div class="col-2">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeClaimPair(${pairId})">
                        Remove
                    </button>
                </div>
            </div>
        `;
        document.getElementById('claimPairs').insertAdjacentHTML('beforeend', pairHtml);
    }

    function removeClaimPair(pairId) {
        document.getElementById(`claimPair${pairId}`)?.remove();
    }

    // Initialize with one empty pair
    addClaimPair();

    // Add Claim button
    document.getElementById('addClaimBtn').addEventListener('click', () => {
        addClaimPair();
    });

    // Custom Claims Form submit
    document.getElementById('customClaimsForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const statusDiv = document.getElementById('customClaimsStatus');
        const btn = document.getElementById('updateClaimsBtn');
        const btnText = document.getElementById('updateClaimsBtnText');
        const btnSpinner = document.getElementById('updateClaimsBtnSpinner');

        // Collect claim key-value pairs
        const keys = Array.from(document.querySelectorAll('input[name="claimKey[]"]')).map(input => input.value.trim());
        const values = Array.from(document.querySelectorAll('input[name="claimValue[]"]')).map(input => input.value.trim());
        const permanent = document.getElementById('permanentClaims').checked;

        // Build claims object
        const claims = {};
        for (let i = 0; i < keys.length; i++) {
            if (keys[i]) { // Only add non-empty keys
                claims[keys[i]] = values[i];
            }
        }

        if (Object.keys(claims).length === 0) {
            statusDiv.innerHTML = '<div class="alert alert-warning">Please add at least one claim</div>';
            return;
        }

        // Show loading state
        btn.disabled = true;
        btnText.textContent = 'Updating...';
        btnSpinner.classList.remove('d-none');
        statusDiv.innerHTML = '';

        try {
            const response = await fetch('@Url.Action("UpdateCustomClaims", "Home")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ claims, permanent })
            });

            const data = await response.json();

            if (data.error) {
                statusDiv.innerHTML = `<div class="alert alert-danger">Error: ${data.error}</div>`;
                btn.disabled = false;
                btnText.textContent = 'Update Claims';
                btnSpinner.classList.add('d-none');
            } else if (data.success) {
                // Claims updated in DB, now refresh from DB to show immediately
                statusDiv.innerHTML = '<div class="alert alert-success">✅ Claims updated in database! Refreshing display...</div>';

                // Auto-refresh claims from DB
                try {
                    await refreshUserClaimsFromDB();
                    statusDiv.innerHTML = `
                        <div class="alert alert-success">
                            ✅ Claims updated successfully!
                            <br>
                            <small class="text-muted">Note: New claims will appear in your ID token after next login.</small>
                        </div>`;
                } catch (error) {
                    statusDiv.innerHTML = `
                        <div class="alert alert-warning">
                            ⚠️ Claims updated but failed to refresh display. Click "🔄 Refresh from DB" to see changes.
                        </div>`;
                }

                btn.disabled = false;
                btnText.textContent = 'Update Claims';
                btnSpinner.classList.add('d-none');
            }
        } catch (error) {
            statusDiv.innerHTML = `<div class="alert alert-danger">Error: ${error.message}</div>`;
            btn.disabled = false;
            btnText.textContent = 'Update Claims';
            btnSpinner.classList.add('d-none');
        }
    });

    // Refresh Token button
    document.getElementById('refreshTokenBtn').addEventListener('click', function() {
        const statusDiv = document.getElementById('customClaimsStatus');
        const btn = this;
        const btnText = document.getElementById('refreshTokenBtnText');
        const btnSpinner = document.getElementById('refreshTokenBtnSpinner');

        btn.disabled = true;
        btnText.textContent = 'Refreshing...';
        btnSpinner.classList.remove('d-none');
        statusDiv.innerHTML = '<div class="alert alert-info">Re-authenticating to get new token with updated claims...</div>';

        // Create a form to POST to RefreshToken endpoint
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("RefreshToken", "Home")';
        document.body.appendChild(form);
        form.submit();
    });

    // Workspace Switch Form
    document.getElementById('workspaceSwitchForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const workspaceSelect = document.getElementById('workspaceSelect');
        const workspaceId = workspaceSelect.value;
        const workspaceName = workspaceSelect.options[workspaceSelect.selectedIndex].text;
        const switchBtn = document.getElementById('switchBtn');
        const switchBtnText = document.getElementById('switchBtnText');
        const switchBtnSpinner = document.getElementById('switchBtnSpinner');
        const statusDiv = document.getElementById('switchStatus');

        if (!workspaceId) {
            statusDiv.innerHTML = '<div class="alert alert-warning">Please select a workspace</div>';
            return;
        }

        // Show loading state
        switchBtn.disabled = true;
        switchBtnText.textContent = 'Switching...';
        switchBtnSpinner.classList.remove('d-none');
        statusDiv.innerHTML = '';

        try {
            const formData = new FormData();
            formData.append('workspaceId', workspaceId);
            formData.append('workspaceName', workspaceName);

            const response = await fetch('@Url.Action("SwitchWorkspace", "Home")', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.error) {
                statusDiv.innerHTML = `<div class="alert alert-danger">Error: ${data.error}</div>`;
                switchBtn.disabled = false;
                switchBtnText.textContent = 'Switch Workspace';
                switchBtnSpinner.classList.add('d-none');
            } else if (data.success) {
                statusDiv.innerHTML = '<div class="alert alert-success">✅ Claims updated! Redirecting to get new token...</div>';

                // Redirect to ReAuthenticate action which will trigger proper OAuth flow
                setTimeout(() => {
                    window.location.href = '@Url.Action("ReAuthenticate", "Home")';
                }, 1000);
            }
        } catch (error) {
            statusDiv.innerHTML = `<div class="alert alert-danger">Error: ${error.message}</div>`;
            switchBtn.disabled = false;
            switchBtnText.textContent = 'Switch Workspace';
            switchBtnSpinner.classList.add('d-none');
        }
    });
</script>
