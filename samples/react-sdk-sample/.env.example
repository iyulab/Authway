# Copy to .env.local and fill in the client id from the registration step.

# The Authway API. The SDK finds the OpenID Connect issuer from it.
VITE_AUTHWAY_URL=http://localhost:8080

# The client_id Authway answered when the sample was registered.
VITE_AUTHWAY_CLIENT_ID=

# The API this application calls with the user's access token (samples/asp-api).
VITE_API_URL=http://localhost:5090
