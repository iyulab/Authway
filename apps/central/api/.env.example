# ============================================================
# Central API Local Environment Variables
# ============================================================
# Copy this file to .env. The defaults below match docker-compose.yml at the
# repo root, so an unmodified copy works out of the box.
#
# This file is loaded relative to the working directory, i.e. when the API is
# started from apps/central/api. There is no repo-root .env.
# ============================================================

# Database Configuration
# The port is 5433, not 5432, so the compose Postgres can coexist with other
# local projects that hold the default port.
AUTHWAY_DATABASE_HOST=localhost
AUTHWAY_DATABASE_PORT=5433
AUTHWAY_DATABASE_USER=authway
AUTHWAY_DATABASE_PASSWORD=authway
# Hydra shares this database, as it does in production.
AUTHWAY_DATABASE_NAME=authway
AUTHWAY_DATABASE_SSL_MODE=disable

# Redis Configuration
# 6380 for the same reason as 5433 above.
AUTHWAY_REDIS_HOST=localhost
AUTHWAY_REDIS_PORT=6380
AUTHWAY_REDIS_PASSWORD=
AUTHWAY_REDIS_DB=0

# Internal API Key for service-to-service authentication
# Must match the Auth Backend's INTERNAL_API_KEY.
AUTHWAY_ADMIN_INTERNAL_API_KEY=dev-internal-key

# Admin Password
AUTHWAY_ADMIN_PASSWORD=authway0

# Email (SMTP) — docker-compose.yml runs MailHog to intercept local mail.
# Without this, the server falls back to config.go's global default
# (port 587, nothing listening locally) and every send fails silently
# (invitation/magic-link/reset/verification emails never arrive — the
# invite/user API calls still return 200/201, so check server logs, not
# just the API response). MailHog needs no auth, so user/password stay unset.
AUTHWAY_EMAIL_SMTP_HOST=localhost
AUTHWAY_EMAIL_SMTP_PORT=1025

# TOTP secret encryption (AES-256-GCM), base64-encoded 32 bytes.
# Generate with: openssl rand -base64 32
# Optional in development — unset, the server warns and stores TOTP secrets as
# plaintext. Required in production: startup fails without it. Adding a key
# later is safe (existing plaintext rows keep working); removing one after
# secrets have been encrypted makes them unreadable.
# AUTHWAY_TOTP_ENCRYPTION_KEY=

# ============================================================
# Note: For production deployment, these values should be set
# in Azure Container App environment variables, not in .env
# ============================================================
