# ============================================================
# Auth Backend (branding) — Local Environment Variables
# ============================================================
# Copy this file to .env and fill in the Google credentials.
#
# These are the only variables this service reads (see
# internal/config/config.go). Values shown are the built-in defaults, so an
# .env with just the two Google secrets is enough for local development
# against docker-compose.yml at the repo root (which also runs Redis).
# ============================================================

# HTTP port
PORT=8081

# development | production
ENVIRONMENT=development

# Directory served for static assets
STATIC_PATH=./static

# Where Hydra sends users to sign in — the auth-ui Vite app
LOGIN_UI_URL=http://localhost:3001

# ------------------------------------------------------------
# Google OAuth — [REQUIRED]
# ------------------------------------------------------------
# Startup fails without these; there is no default. Create credentials at
# https://console.cloud.google.com/apis/credentials and register the redirect
# URI below as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/auth/google/callback

# ------------------------------------------------------------
# Central API
# ------------------------------------------------------------
CENTRAL_API_URL=http://localhost:8080

# Shared secret for /internal/* calls. Must match the Central API's
# AUTHWAY_ADMIN_INTERNAL_API_KEY.
INTERNAL_API_KEY=dev-internal-key

# ------------------------------------------------------------
# Ory Hydra (started by docker-compose.yml at the repo root)
# ------------------------------------------------------------
HYDRA_ADMIN_URL=http://localhost:4445
HYDRA_PUBLIC_URL=http://localhost:4444

# ------------------------------------------------------------
# Redis — backs the OAuth state store.
# Shared with the Central API's own Redis usage (started by docker-compose.yml
# at the repo root); 6380 not 6379 for the same reason apps/central/api's
# .env.example uses it — so the compose Redis can coexist with other local
# projects that hold the default port. Without this, config.go's built-in
# default (port 6379) points at nothing locally and startup fails closed.
# ------------------------------------------------------------
AUTHWAY_REDIS_HOST=localhost
AUTHWAY_REDIS_PORT=6380
AUTHWAY_REDIS_PASSWORD=
AUTHWAY_REDIS_DB=0
