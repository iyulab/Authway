{
  "name": "@authway/client",
  "version": "0.3.0",
  "description": "Framework-agnostic authentication client for Authway - OAuth 2.0 / OIDC with PKCE, DPoP, and multi-tenant support",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./popup-callback": {
      "import": {
        "types": "./dist/popup-callback.d.mts",
        "default": "./dist/popup-callback.mjs"
      },
      "require": {
        "types": "./dist/popup-callback.d.ts",
        "default": "./dist/popup-callback.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:package": "publint --pack npm && attw --pack . --profile node16",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "authway",
    "oauth",
    "oauth2",
    "oidc",
    "openid",
    "authentication",
    "pkce",
    "dpop",
    "multi-tenant",
    "jwt",
    "auth",
    "sso",
    "account-linking"
  ],
  "author": "Authway Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyulab/authway.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/iyulab/authway#readme",
  "bugs": {
    "url": "https://github.com/iyulab/authway/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "sideEffects": [
    "./dist/popup-callback.mjs",
    "./dist/popup-callback.cjs"
  ]
}
