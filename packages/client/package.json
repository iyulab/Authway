{
  "name": "@authway/client",
  "version": "0.2.7",
  "description": "Framework-agnostic authentication client for Authway - OAuth 2.0 / OIDC with PKCE, DPoP, and multi-tenant support",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./popup-callback": {
      "types": "./dist/popup-callback.d.ts",
      "import": "./dist/popup-callback.mjs",
      "require": "./dist/popup-callback.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "authway",
    "oauth",
    "oauth2",
    "oidc",
    "openid",
    "authentication",
    "pkce",
    "dpop",
    "multi-tenant",
    "jwt",
    "auth",
    "sso",
    "account-linking"
  ],
  "author": "Authway Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/authway.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/iyulab/authway#readme",
  "bugs": {
    "url": "https://github.com/iyulab/authway/issues"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "@eslint/js": "^10.0.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  },
  "sideEffects": [
    "./dist/popup-callback.mjs",
    "./dist/popup-callback.cjs"
  ]
}
