{
  "name": "@authway/contract",
  "version": "0.1.0",
  "private": true,
  "description": "The contract every Authway implementation answers: the API the bundled screens use, and their runtime configuration",
  "type": "module",
  "exports": {
    "./openapi.yaml": "./openapi.yaml",
    "./runtime-config.schema.json": "./runtime-config.schema.json",
    "./schema": {
      "types": "./schema.d.ts"
    }
  },
  "files": [
    "openapi.yaml",
    "runtime-config.schema.json",
    "schema.d.ts"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o schema.d.ts"
  }
}
