{
  "name": "@authway/react",
  "version": "0.3.0",
  "description": "React integration for Authway authentication - Hooks, Context, and HOCs for OAuth 2.0 / OIDC",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.mjs",
      "require": "./dist/ssr/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@authway/client": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "@eslint/js": "^10.0.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1",
    "eslint-plugin-react-hooks": "^7.1.1"
  },
  "keywords": [
    "authway",
    "react",
    "authentication",
    "hooks",
    "oauth",
    "oauth2",
    "oidc",
    "context",
    "hoc",
    "auth",
    "jwt",
    "pkce"
  ],
  "author": "Authway Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/authway.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/iyulab/authway#readme",
  "bugs": {
    "url": "https://github.com/iyulab/authway/issues"
  }
}
