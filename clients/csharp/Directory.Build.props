<Project>

  <!-- Self-contained: nothing above this directory is imported, and nothing outside it inherits these settings. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Comments are for what needs saying: no comment is required (CS1591), and a parameter list may explain only some of its parameters (CS1573) -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>iyulab</Authors>
    <Company>iyulab</Company>
    <Copyright>Copyright (c) 2026 iyulab</Copyright>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <RepositoryUrl>https://github.com/iyulab/Authway</RepositoryUrl>
    <PackageProjectUrl>https://github.com/iyulab/Authway/tree/main/clients/csharp</PackageProjectUrl>
  </PropertyGroup>

</Project>
