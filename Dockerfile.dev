# Development Dockerfile for Authway Backend
# Simplified version without hot-reload

FROM golang:1.25-alpine

# Install development tools
RUN apk add --no-cache git ca-certificates tzdata gcc musl-dev

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY src/ ./src/

# Copy config
COPY configs/ ./configs/

# Build the application
RUN CGO_ENABLED=1 GOOS=linux go build -o authway ./src/server/cmd/main.go

# Expose port
EXPOSE 8080

# Run the application
CMD ["./authway"]
