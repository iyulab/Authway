# Authway installation settings — the only file to edit.
# `sh setup.sh` copies this to .env and fills in every secret; then set the
# address and mail below and run `docker compose up -d`.

# The address users and applications reach Authway at (a host name, with a
# port if it is not 443). It becomes the issuer every token names — choose it
# once; changing it later invalidates every application's configuration.
AUTHWAY_DOMAIN=auth.example.internal

# How the certificate for that address is obtained (see README.md):
#   internal                          Caddy's own certificate authority
#   admin@example.com                 Let's Encrypt (the address must be public)
#   /certs/site.crt /certs/site.key   your own, placed in ./certs
AUTHWAY_TLS=internal
# With a port in AUTHWAY_DOMAIN, set AUTHWAY_HTTPS_PORT to the same number.
#AUTHWAY_HTTP_PORT=80
#AUTHWAY_HTTPS_PORT=443

# Mail for invitations, sign-in links, address checks and password resets.
AUTHWAY_EMAIL_SMTP_HOST=
AUTHWAY_EMAIL_SMTP_PORT=587
AUTHWAY_EMAIL_SMTP_USER=
AUTHWAY_EMAIL_SMTP_PASSWORD=
# empty (STARTTLS when offered), tls, starttls or none
AUTHWAY_EMAIL_SMTP_SECURITY=
AUTHWAY_EMAIL_FROM_EMAIL=
AUTHWAY_EMAIL_FROM_NAME=Authway

# Images (loaded with `docker load -i images.tar`, or pulled where a registry
# is reachable).
#AUTHWAY_API_IMAGE=authway-api:latest
#AUTHWAY_WEB_IMAGE=authway-web:latest
#AUTHWAY_LOG_LEVEL=info

# --- Secrets: setup.sh generates these. Keep a copy of .env somewhere safe —
# --- the database and every stored second factor depend on them.
AUTHWAY_DATABASE_PASSWORD=
AUTHWAY_HYDRA_SECRETS_SYSTEM=
AUTHWAY_HYDRA_TOKEN_HOOK_KEY=
AUTHWAY_ADMIN_API_KEY=
AUTHWAY_ADMIN_PASSWORD=
AUTHWAY_TOTP_ENCRYPTION_KEY=
AUTHWAY_JWT_ACCESS_TOKEN_SECRET=
AUTHWAY_JWT_REFRESH_TOKEN_SECRET=
