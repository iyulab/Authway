# Authorization-server (Ory Hydra) settings that are the same in every Authway
# deployment — local development, CI, staging, production.
#
# The shared contract (packages/contract) and its conformance suite depend on
# these: they shape the tokens a relying party reads and what discovery
# advertises. They are written once, here, and every place that starts Hydra
# reads this file:
#
#   docker-compose.yml                       env_file
#   .github/workflows/ci.yml                 docker run --env-file
#   scripts/deploy/_shared/hydra-shared-env.ps1   (publish-hydra, verify-hydra-env)
#
# What differs per environment — addresses, the database, secrets, CORS, log
# level — stays where that environment is described.
#
# Format: KEY=value, one per line, no quotes (docker --env-file).

# Access tokens are opaque unless a client asks for JWTs
# (access_token_strategy on the client). Pinned rather than left to Hydra's
# default, so a change of that default cannot switch every client's format.
STRATEGIES_ACCESS_TOKEN=opaque

# A JWT access token carries its scopes both ways: `scope`, the space-separated
# string of RFC 9068 that standard validators read, and `scp`, Hydra's array.
STRATEGIES_JWT_SCOPE_CLAIM=both

# A JWT access token carries Authway's own claims at the top level, where any
# JWT library reads them. Hydra otherwise nests every session claim under
# `ext`. A deployment adds the names of its custom claims with
# HYDRA_ALLOWED_TOP_LEVEL_CLAIMS (deploy .env); they are appended to this list.
OAUTH2_ALLOWED_TOP_LEVEL_CLAIMS=tenant_id,email,name,auth_time,act

# What discovery says the provider issues (Hydra adds `sub`, and `openid` and
# `offline_access`, itself).
WEBFINGER_OIDC_DISCOVERY_SUPPORTED_CLAIMS=tenant_id,email,email_verified,name,auth_time,amr
WEBFINGER_OIDC_DISCOVERY_SUPPORTED_SCOPE=profile,email

# The calls Hydra makes to addresses clients gave it — a back-channel logout
# address, a JWKS address — do not reach this host or private networks. A
# client with such an address is refused at registration, by what the host
# name resolves to, and the address is checked again whenever Hydra connects.
# The API refuses the same addresses first with a clearer answer
# (AUTHWAY_ALLOW_PRIVATE_TARGETS); this is the check on the side that makes
# the call. Local development and CI set it to false: their receivers run on
# the same machine.
CLIENTS_HTTP_DISALLOW_PRIVATE_IP_RANGES=true
# Device sign-in (RFC 8628): the code a user copies from a TV or a terminal to
# a phone or computer is eight capital letters, which the API reads without
# regard to case (RFC 8628 §6.1). Hydra's default mixes cases.
OAUTH2_DEVICE_AUTHORIZATION_USER_CODE_ENTROPY_PRESET=medium

# The token hook (OAUTH2_TOKEN_HOOK_*) is not here: Hydra refuses to start
# with its key settings but no address, and only the process that issues
# tokens calls it. It is set with its address where each Hydra is started
# (scripts/deploy/_shared/hydra-flow-urls.ps1, docker-compose.yml, ci.yml).

# Token lifetimes.
TTL_ACCESS_TOKEN=1h
TTL_REFRESH_TOKEN=720h
TTL_ID_TOKEN=1h
TTL_AUTH_CODE=10m
