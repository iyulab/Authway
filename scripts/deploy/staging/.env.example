# ============================================================
# Authway Staging 배포 환경 변수 (2026-04-15 결정)
# ============================================================
# 이 파일을 `.env`로 복사하여 staging 디렉터리에 두고 값을 채운다.
#   cp staging/.env.example staging/.env
#
# Invocation:
#   staging/publish-*.ps1      # staging/.env 로드
#   staging/deploy-all.ps1     # staging 전체 배포
#
# 설계 근거: `ISSUE-Authway-20260415-audit-smoke-staging-automation.md`
# 옵션 A' — 경량 staging 분리 (기존 리소스 최대 재사용):
#   • 동일 RG `authway` 내 `-stg` 접미사 공존
#   • 기존 Redis 재사용 + DB 번호 분리 (0=prod, 1=staging)
#   • 기존 Postgres Flexible Server + 신규 DB `authway_staging`
#   • Container App scale-to-zero (min-replicas=0) → idle 비용 0
# ============================================================
# 태그 규약:
#   [STAGING-ONLY]       prod와 반드시 달라야 하는 값 (secret 등)
#   [shared w/ prod OK]  prod와 동일 값 사용 가능
# ============================================================

# -----------------------------------------------------------
# Azure 기본
# -----------------------------------------------------------

# [shared w/ prod OK] 동일 구독
AZURE_SUBSCRIPTION_ID=

# [shared w/ prod OK] 기존 RG 재사용. 리소스명에 -stg 접미사로 구분
RESOURCE_GROUP=authway

# [shared w/ prod OK] 동일 region
LOCATION=koreacentral

# [shared w/ prod OK] 기존 Container Apps Environment 재사용
# 주의: prod와 환경 공유 시 VNet 세그먼트 경계가 흐려지지만, 비용/운영 단순화를 위해 수용.
#       staging 장애의 prod 영향 가능성은 scale-to-zero + 리소스 분리로 최소화.
CONTAINER_ENVIRONMENT=authway-env

# -----------------------------------------------------------
# Database — 기존 Postgres Flexible Server + 신규 DB
# -----------------------------------------------------------

# [shared w/ prod OK] 동일 host
AUTHWAY_DATABASE_HOST=authway.postgres.database.azure.com
AUTHWAY_DATABASE_PORT=5432

# [STAGING-ONLY] 신규 DB. Hydra/Authway 테이블 완전 격리.
#   prerequisite: Postgres에 CREATE DATABASE authway_staging 실행 (관리자 권한 필요)
AUTHWAY_DATABASE_NAME=authway_staging

# [STAGING-ONLY] 전용 role 권장 (prod role로 접근 금지)
#   생성 SQL:
#     CREATE ROLE authway_staging LOGIN PASSWORD '<staging-password>';
#     GRANT ALL ON DATABASE authway_staging TO authway_staging;
AUTHWAY_DATABASE_USER=authway_staging
AUTHWAY_DATABASE_PASSWORD=your-staging-database-password-here

# -----------------------------------------------------------
# Redis — 기존 인스턴스 재사용 + DB 번호 분리
# -----------------------------------------------------------

# [shared w/ prod OK] 동일 Redis 인스턴스 (host/port/password/TLS)
AUTHWAY_REDIS_HOST=authway.redis.cache.windows.net
AUTHWAY_REDIS_PORT=6380
AUTHWAY_REDIS_PASSWORD=
AUTHWAY_REDIS_TLS_ENABLED=true

# [STAGING-ONLY] prod=0, staging=1. 세션/캐시 충돌 방지.
AUTHWAY_REDIS_DB=1

# -----------------------------------------------------------
# Container Apps (모두 scale-to-zero 권장: min-replicas=0)
# -----------------------------------------------------------

# [STAGING-ONLY] 서비스 이름에 -stg 접미사
CONTAINER_APP_HYDRA=authway-hydra-stg
CONTAINER_APP_API=authway-api-stg
CONTAINER_APP_AUTH_API=auth-api-stg

# [STAGING-ONLY] 별도 Static Web App 프로비저닝
STATIC_WEB_APP_ADMIN=authway-admin-stg
STATIC_WEB_APP_AUTH_UI=auth-ui-stg

# -----------------------------------------------------------
# URLs — staging 전용 서브도메인 (stg- prefix 규약)
# -----------------------------------------------------------

# [STAGING-ONLY] 모두 staging 도메인
HYDRA_ISSUER=https://stg-oauth.authway.in
LOGIN_URL=https://stg-auth.authway.in/login
CONSENT_URL=https://stg-auth.authway.in/consent
ERROR_URL=https://stg-auth.authway.in/error
API_URL=https://stg-api.authway.in
AUTH_API_URL=https://stg-auth-api.authway.in
ADMIN_URL=https://stg-admin.authway.in

# [STAGING-ONLY] Container Apps Environment 내부 FQDN
# 참고: prod Hydra admin은 별도 Container App (authway-hydra-admin)으로 분리되어 있음.
#       staging도 동일 패턴 적용 시 URL 확정 후 채움.
HYDRA_ADMIN_INTERNAL_URL=
API_INTERNAL_URL=https://stg-api.authway.in

# -----------------------------------------------------------
# Secrets — [STAGING-ONLY] prod와 공유 절대 금지
# -----------------------------------------------------------
# 공유 시 prod secret rotation이 staging도 중단시킴. 보안 경계 파괴.
# 신규 생성: openssl rand -base64 64 (JWT), openssl rand -base64 48 (API key)

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# [STAGING-ONLY] Hydra master key — JWT_ACCESS_SECRET과 다른 값 필수. openssl rand -base64 64
HYDRA_SECRETS_SYSTEM=
ADMIN_API_KEY=
INTERNAL_API_KEY=

# Admin Console 비밀번호 (staging 전용, 팀 bitwarden 등 공유)
AUTHWAY_ADMIN_PASSWORD=

# Static Web App deployment tokens (staging SWA 생성 후 발급)
ADMIN_DEPLOYMENT_TOKEN=
AUTH_UI_DEPLOYMENT_TOKEN=

# [shared w/ prod OK] 동일 GHCR 계정 (staging은 prod와 같은 이미지 + 다른 env 사용 가능)
GITHUB_TOKEN=
GITHUB_USER=iyulab

# -----------------------------------------------------------
# Application
# -----------------------------------------------------------

# [STAGING-ONLY] 환경 구분 (로그 필터링, 외부 도구용)
APP_ENVIRONMENT=staging
LOG_LEVEL=debug

# [STAGING-ONLY] CORS 원점은 staging 도메인만 허용
ADMIN_ORIGINS=https://stg-admin.authway.in
AUTH_UI_ORIGINS=https://stg-auth.authway.in
CORS_ALLOWED_ORIGINS=https://stg-auth.authway.in,https://stg-admin.authway.in

# -----------------------------------------------------------
# Email — Azure Functions 재사용 가능. FROM NAME에 [STAGING] prefix 필수.
# -----------------------------------------------------------
EMAIL_USE_AZURE=true
EMAIL_AZURE_BASE_URL=
EMAIL_AZURE_FUNCTION_KEY=
# 게이트웨이 프로필 ID (예: authway-noreply). 미지정 시 게이트웨이 default 사용.
EMAIL_AZURE_PROFILE=authway-noreply
EMAIL_FROM_EMAIL=noreply@authway.in
EMAIL_FROM_NAME=[STAGING] Authway

# SMTP Fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# -----------------------------------------------------------
# Social OAuth — staging redirect URI 별도 등록 필요
# -----------------------------------------------------------
# Google Cloud Console → OAuth client → staging callback URL 추가:
#   https://stg-auth-api.authway.in/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://stg-auth-api.authway.in/auth/google/callback
