# ============================================================
# Authway Azure 배포 환경 변수
# ============================================================
# 이 파일을 .env로 복사하고 실제 값으로 채워주세요.
# ============================================================

# Azure Resource Group
# AZURE_SUBSCRIPTION_ID: 배포 대상 구독 GUID. publish-*.ps1 preflight가 `az account set`으로 고정.
#                       미설정 시 배포 스크립트 fail-closed. 확인: `az account list -o table`
AZURE_SUBSCRIPTION_ID=
RESOURCE_GROUP=
LOCATION=
CONTAINER_ENVIRONMENT=

# Database (이미 배포됨)
AUTHWAY_DATABASE_HOST=
AUTHWAY_DATABASE_PORT=5432
AUTHWAY_DATABASE_NAME=
AUTHWAY_DATABASE_USER=
AUTHWAY_DATABASE_PASSWORD=your-database-password-here

# Redis (이미 배포됨)
AUTHWAY_REDIS_HOST=
AUTHWAY_REDIS_PORT=6380
AUTHWAY_REDIS_PASSWORD=your-redis-password-here
AUTHWAY_REDIS_TLS_ENABLED=true
AUTHWAY_REDIS_DB=0

# Container Apps
CONTAINER_APP_HYDRA=
CONTAINER_APP_HYDRA_ADMIN=
CONTAINER_APP_API=
CONTAINER_APP_AUTH_API=auth-api

# Static Web Apps (이미 배포됨)
STATIC_WEB_APP_ADMIN=
STATIC_WEB_APP_AUTH_UI=auth-ui

# ============================================================
# Cloudflare Pages (Phase 3 이전 후 활성화)
# ============================================================
# AUTH_UI_DEPLOY_PLATFORM=cloudflare  → publish-auth-ui.ps1이 CF Pages 경로 사용
# ADMIN_DEPLOY_PLATFORM=cloudflare    → publish-admin.ps1이 CF Pages 경로 사용
# Landing page는 Cloudflare Pages 전용(Azure 대안 없음) — apex 도메인 authway.in
# 자체가 Cloudflare DNS로 이전돼 apex CNAME flattening이 필요해서 Cloudflare Pages로
# 고정. publish-landing.ps1은 항상 이 값들을 사용.
# Cloudflare 대시보드: Account ID (우측 사이드바), API Token (My Profile → API Tokens)
AUTH_UI_DEPLOY_PLATFORM=azure
ADMIN_DEPLOY_PLATFORM=azure
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT_AUTH_UI=authway-auth-ui
CLOUDFLARE_PAGES_PROJECT_ADMIN=authway-admin
CLOUDFLARE_PAGES_PROJECT_LANDING=authway-landing

# Admin Console Password
# This password is used to access the Admin Dashboard at https://admin.authway.in
AUTHWAY_ADMIN_PASSWORD=your-secure-admin-password-here

# Static Web App Deployment Tokens
# Azure Portal → Static Web App → Manage deployment token
ADMIN_DEPLOYMENT_TOKEN=your-admin-deployment-token-here
AUTH_UI_DEPLOYMENT_TOKEN=your-auth-ui-deployment-token-here

# GitHub Container Registry
GITHUB_TOKEN=your-github-token-here
GITHUB_USER=your-name-here

# Public URLs
HYDRA_ISSUER=
LOGIN_URL=
CONSENT_URL=
ERROR_URL=
API_URL=
AUTH_API_URL=
ADMIN_URL=

# Internal URLs (for Container Apps communication)
# These will be set to internal FQDN after Container Apps are created
HYDRA_ADMIN_INTERNAL_URL=
API_INTERNAL_URL=

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_ACCESS_SECRET=your-jwt-access-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# Hydra cookie/session master key — 반드시 JWT_ACCESS_SECRET과 다른 값 사용.
# 두 키 공유 시 한 시스템 침해가 다른 시스템 침해로 전파됨 (blast radius 결합).
# Generate: openssl rand -base64 64
# 변경 시 Hydra의 모든 활성 세션이 무효화됨 — 메인터넌스 윈도우에서 진행.
HYDRA_SECRETS_SYSTEM=your-hydra-secrets-system-here

# ============================================================
# Admin API authentication keys (REQUIRED in production)
# ============================================================
# Missing either key causes central API to refuse startup in production
# (see apps/central/api/internal/config/config.go validation).
# ADMIN_API_KEY guards /api/v1/clients, /api/v1/users, /api/v1/docs (write),
#   and all tenant-admin routes from unauthenticated access.
# INTERNAL_API_KEY guards /internal/* (branding auth-api → central calls).
# Generate with: openssl rand -base64 48
# Rotating: update here, redeploy API, then update any consumer (auth-api,
#   admin console, CI) that uses these values before discarding the old key.
ADMIN_API_KEY=your-admin-api-key-here
INTERNAL_API_KEY=your-internal-api-key-here

# AUTHWAY_TOTP_ENCRYPTION_KEY encrypts TOTP secrets at rest (AES-256-GCM).
# Required in production — central API refuses startup without it
# (see apps/central/api/internal/config/config.go validation).
# MUST base64-decode to exactly 32 bytes. Generate with: openssl rand -base64 32
# Use a DIFFERENT key per environment (do not share prod/staging keys).
# Rotating invalidates every stored TOTP secret — users must re-enrol MFA.
AUTHWAY_TOTP_ENCRYPTION_KEY=your-base64-32-byte-key-here

# Application Settings
APP_ENVIRONMENT=production
LOG_LEVEL=info

# CORS Settings
ADMIN_ORIGINS=
AUTH_UI_ORIGINS=
CORS_ALLOWED_ORIGINS=

# JWT access token에서 top-level로 노출할 커스텀 클레임 이름 (쉼표 구분, 선택).
# Hydra는 세션 클레임을 기본적으로 `ext` 하위에 중첩한다. 클레임명을 그대로
# 읽는 리소스 서버가 있을 때만 그 이름들을 여기 나열한다.
# 이름은 소비 서비스의 도메인 개념이므로 배포 구성으로만 관리한다(코드 하드코딩 금지).
# 비우면 설정 자체를 보내지 않는다 → Hydra 기본(ext 중첩) 유지.
# 예: HYDRA_ALLOWED_TOP_LEVEL_CLAIMS=kind,tenant
HYDRA_ALLOWED_TOP_LEVEL_CLAIMS=

# ============================================================
# Email — Sendway (iyulab's own notification service, org/dev-docs/sendway.md)
# ============================================================
# EMAIL_USE_SENDWAY=true 시 Sendway 경로, false 시 SMTP fallback.
# 테넌트 API 키는 여기 넣지 않는다 — authway-api Container App의 secret
# `sendway-api-key`로 이미 provisioning 돼 있고, publish-api.core.ps1이
# secretref:sendway-api-key로 참조한다. 키를 회전하려면
# `az containerapp secret set -n authway-api -g authway --secrets sendway-api-key=<new-key>`.
EMAIL_USE_SENDWAY=true
EMAIL_SENDWAY_BASE_URL=sendway.u-platform.kr
# Sendway 요청엔 발신자 필드가 없다 — "noreply@authway.in"/"Authway" 표시를 유지하려면
# Sendway 관리자에게 이 테넌트(authway)의 credential override를 별도로 요청해야 한다.
EMAIL_FROM_EMAIL=noreply@authway.in
EMAIL_FROM_NAME=Authway

# SMTP Fallback (EMAIL_USE_SENDWAY=false 시 사용)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://auth-api.authway.in/auth/google/callback

# -----------------------------------------------------------
# Azure Container Registry (ACR) — iyulabimages.azurecr.io
# -----------------------------------------------------------
# Hydra 공식 이미지(oryd/hydra)를 Docker Hub 레이트 리밋 없이 pull하기 위해 ACR에 캐싱.
# publish-hydra.core.ps1이 배포마다 az containerapp registry set을 실행 (idempotent).
# 자격증명: Azure Portal → iyulabImages ACR → Access keys
ACR_USERNAME=iyulabImages
ACR_PASSWORD=your-acr-admin-password-here
